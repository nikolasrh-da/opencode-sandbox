{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["/home/agent/sandbox-config/AGENTS.md"],
  "permission": {
    "external_directory": "allow",
    "bash": {
      "npm": "deny",
      "npx": "deny",
      "yarn": "deny",
      "pnpm": "allow"
    }
  },
  "agent": {
    "build": {
      "model": "github-copilot/claude-sonnet-5-5",
      "permission": { "task": "allow" }
    },
    "plan": {
      "model": "github-copilot/gpt-6.1-terra",
      "permission": {
        // "*": "deny",
        "task": "allow",
        "edit": {
          "/home/agent/sandbox-notes/*": "allow"
        }
      }
    },
    "general": {
      "model": "github-copilot/gpt-6-luna",
      "variant": "max"
    },
    "explore": {
      "model": "github-copilot/gpt-6-luna",
      "variant": "max"
    }
  }
}
